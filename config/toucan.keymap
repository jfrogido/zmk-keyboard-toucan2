#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer numbering matches the Corne config: Colemak=0, QWERTY=1, NAV=2, SYM=3.
// ADJ=4 (tri-layer: NAV+SYM held together) and MOUSE=5 (auto-activated by
// trackpad touch, see boards/shields/toucan/toucan.dtsi) are Toucan2-only
// additions the Corne doesn't need (no BT, no trackpad).
#define COLEMAK 0
#define QWERTY 1
#define NAV    2
#define SYM    3
#define ADJ    4
#define MOUSE  5

/ {
    behaviors {
        // Positional home row mods: hold only fast-resolves when the OTHER hand
        // presses+releases a key (balanced flavor + hold-trigger-key-positions).
        // Same-hand combos (e.g. Ctrl+Z, both on the left hand in Colemak DH)
        // still work, just need a deliberate ~280ms hold instead of a quick tap.
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            display-name = "CLMK";
            // Colemak DH, home row mods, inner thumbs = NAV/SYM, outer right thumb = QWERTY toggle
            bindings = <
&kp ESC    &kp Q         &kp W        &kp F        &kp P         &kp B        &kp J    &kp L         &kp U        &kp Y        &kp SEMI      &kp BSPC
&kp GRAVE  &hml LCTRL A  &hml LALT R  &hml LGUI S  &hml LSHFT T  &kp G        &kp M    &hmr RSHFT N  &hmr RGUI E  &hmr RALT I  &hmr RCTRL O  &kp SQT
&kp BSLH   &kp Z         &kp X        &kp C        &kp D         &kp V        &kp K    &kp H         &kp COMMA    &kp DOT      &kp FSLH      &kp DEL
                                      &kp TAB      &kp RET       &mo NAV      &mo SYM  &kp SPACE     &tog QWERTY
            >;
        };

        qwerty {
            display-name = "QWRT";
            // Standard QWERTY (Hebrew input), same home row mod pattern, CapsLock for IME switching
            bindings = <
&kp ESC       &kp Q         &kp W        &kp E        &kp R         &kp T        &kp Y    &kp U         &kp I        &kp O        &kp P            &kp BSPC
&kp CAPSLOCK  &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G        &kp H    &hmr RSHFT J  &hmr RGUI K  &hmr RALT L  &hmr RCTRL SEMI  &kp SQT
&kp GRAVE     &kp Z         &kp X        &kp C        &kp V         &kp B        &kp N    &kp M         &kp COMMA    &kp DOT      &kp FSLH         &kp DEL
                                         &trans       &kp RET       &mo NAV      &mo SYM  &kp SPACE     &tog QWERTY
            >;
        };

        nav {
            display-name = "NAV";
            // Left: F-keys + mods. Right: arrows/paging + media/volume.
            bindings = <
&kp CAPSLOCK   &kp F1     &kp F2    &kp F3    &kp F4     &kp F5       &kp PG_UP   &kp HOME  &kp UP     &kp END       &kp PG_DN     &kp BSPC
&kp LA(LSHFT)  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &kp F10      &trans      &kp LEFT  &kp DOWN   &kp RIGHT     &trans        &kp SQT
&kp TAB        &kp F6     &kp F7    &kp F8    &kp F9     &kp F10      &kp C_PREV  &kp C_PP  &kp LCTRL  &kp C_VOL_DN  &kp C_VOL_UP  &kp DEL
                                    &trans    &trans     &mo NAV      &trans      &kp BSPC  &trans
            >;
        };

        sym {
            display-name = "SYM";
            // Left: screenshot + coding symbols. Right: numpad.
            bindings = <
&kp LC(LG(LS(N4)))  &kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT      &kp MINUS  &kp N7  &kp N8  &kp N9  &kp N0     &kp BSPC
&kp LGUI            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR       &kp UNDER  &kp N4  &kp N5  &kp N6  &kp EQUAL  &kp PLUS
&kp LSHFT           &kp LBKT   &kp RBKT  &kp LBRC   &kp RBRC  &kp UNDER      &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp DOT    &kp DEL
                                         &kp LSHFT  &kp LALT  &trans         &kp RET    &kp N0  &trans
            >;
        };

        adj {
            display-name = "ADJ";
            // Auto-activated by holding NAV+SYM together. BT profiles + output toggle + reset.
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &trans  &trans  &trans  &trans  &bootloader
&trans      &trans        &trans        &trans        &trans        &trans            &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
&trans      &trans        &trans        &trans        &trans        &trans            &trans  &trans  &trans  &trans  &trans  &studio_unlock
                                        &trans        &trans        &trans            &trans  &trans  &trans
            >;
        };

        mouse {
            display-name = "MOUSE";
            // Auto-activated while touching the trackpad (is_touching_processor in toucan.dtsi).
            // Left home row (R/S/T on Colemak, S/D/F on QWERTY) becomes mouse clicks, so the
            // left hand can click while the right hand/thumb works the trackpad. Rest transparent.
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans
                           &trans     &trans     &trans      &trans  &trans  &trans
            >;
        };
    };
};
